---
/**
 * Blog post pages, one per entry in src/content/blog/: centered title, the
 * Markdown body in a 75%-wide column (full width on mobile), then Previous /
 * Next links in date order (Previous = newer, as on the live site).
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/global/JsonLd.astro';
import ItemPagination from '../../components/global/ItemPagination.astro';
import { blogPostingGraph } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const shareImage = await getImage({ src: post.data.thumbnail, width: 1200, format: 'jpg' });
const link = (p: CollectionEntry<'blog'>) => ({ href: `/blog/${p.id}`, title: p.data.title });
---

<BaseLayout
  title={`${post.data.seoTitle ?? post.data.title} | Electric Collab`}
  description={post.data.description}
  image={{ src: shareImage.src, width: Number(shareImage.attributes.width), height: Number(shareImage.attributes.height) }}
  ogType="article"
>
  <JsonLd
    slot="head"
    data={blogPostingGraph({
      title: post.data.title,
      description: post.data.description,
      path,
      image: shareImage.src,
      author: post.data.author,
      publishDate: post.data.publishDate,
      updatedDate: post.data.updatedDate,
    })}
  />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Electric Collab blog" href="/blog/rss.xml" />
  <link slot="head" rel="preload" href="/fonts/alice-400-latin.woff2" as="font" type="font/woff2" crossorigin />

  <article class="post theme-dark" aria-labelledby="post-title">
    <div class="inner">
      <h1 id="post-title" class="post-title">{post.data.title}</h1>
      <div class="post-body rte">
        <Content />
      </div>
    </div>
  </article>

  <ItemPagination prev={prev && link(prev)} next={next && link(next)} theme="dark" />
</BaseLayout>

<style>
  .post {
    padding: calc(var(--header-height) + var(--page-gutter)) var(--page-gutter) calc(var(--page-gutter) + 3vw);
  }

  .inner {
    max-width: 75%;
    margin-inline: auto;
  }

  .post-title {
    margin: 32px 0 50px; /* 32px: Squarespace's (hidden) date/author row */
    font-family: var(--font-post-title);
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  /*
   * Body content comes from Markdown, so it isn't scoped. Squarespace laid
   * posts out as stacked blocks with 17px padding each: images sit 34px from
   * neighbouring text, and the body ends 17px below its last line.
   */
  .post-body {
    padding-bottom: 17px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .post-body :global(img) {
    display: block;
    max-width: 100%;
    margin-inline: auto;
    height: auto;
  }

  .post-body > :global(p:has(> img:only-child)),
  .post-body > :global(p:has(> img:only-child) + *) {
    margin-top: 34px;
  }

  .post-body > :global(:first-child:first-child) {
    margin-top: 0; /* doubled to outrank the image-spacing rule above */
  }

  .post-body :global(hr) {
    height: 1px;
    margin-block: calc(34px + 0.5em);
    border: 0;
    background-color: currentColor;
  }

  .post-body > :global(hr + *) {
    margin-top: calc(34px + 0.5em);
  }

  /* Spacer block: 34px tall plus a block's padding either side. */
  .post-body :global(.spacer) {
    height: 34px;
  }

  .post-body > :global(.spacer),
  .post-body > :global(.spacer + *) {
    margin-top: 34px;
  }

  .post-body :global(.text-center) {
    text-align: center;
  }

  /* Numbered section headings: the number is drawn in the heading's own font. */
  /* Half a heading's height above and below, as on live. */
  .post-body > :global(ol:has(> li > :is(h2, h3, h4))),
  .post-body > :global(ol:has(> li > :is(h2, h3, h4)) + *) {
    margin-top: 0;
  }

  /* Straight after a heading, that heading's 32px gap applies instead. */
  .post-body > :global(:is(h2, h3, h4) + ol:has(> li > :is(h2, h3, h4))) {
    margin-top: 32px;
  }

  .post-body > :global(:is(h2, h3, h4) + ol > li:first-child > :is(h2, h3, h4):first-child) {
    margin-top: 0;
  }

  /* At the start of a text block (after an image) the list's own margin is dropped. */
  .post-body > :global(p:has(> img:only-child) + ol > li:first-child > :is(h2, h3, h4):first-child) {
    margin-top: 0.5em;
  }

  .post-body :global(ol:has(> li > :is(h2, h3, h4))) {
    display: flow-root; /* the heading's margins add to, not merge with, image spacing */
    padding-left: 40px;
    list-style: none;
  }

  .post-body :global(li:has(> :is(h2, h3, h4):first-child)) {
    display: block; /* only the heading counts as the list item */
  }

  .post-body :global(li > :is(h2, h3, h4):first-child) {
    display: list-item;
    /* Squarespace: the larger of half the heading size and the list's 1em margin. */
    margin-block: max(0.5em, var(--fs-body));
    list-style: decimal outside;
  }

  @media (max-width: 767px) {
    .inner {
      max-width: none;
    }

    .post-title {
      margin-top: 19.2px;
    }

    .post-body {
      padding-top: 17px;
    }

    /* Squarespace drops spacer blocks on mobile. */
    .post-body :global(.spacer) {
      display: none;
    }
  }
</style>
