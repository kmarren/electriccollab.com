---
/**
 * Case-study pages, one per entry in src/content/portfolio/. Projects with
 * `caseStudy` data render the full page; the rest stay as noindex
 * placeholders until they're migrated.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/global/JsonLd.astro';
import CaseStudy from '../../components/case-study/CaseStudy.astro';
import ItemPagination from '../../components/case-study/ItemPagination.astro';
import { caseStudyGraph } from '../../lib/schema';

export async function getStaticPaths() {
  const projects = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'portfolio'>;
  prev?: CollectionEntry<'portfolio'>;
  next?: CollectionEntry<'portfolio'>;
}

const { project, prev, next } = Astro.props;
const cs = project.data.caseStudy;

// The project headline (the page's h1) as plain text, for the meta description and schema.
const headingHtml = cs?.sections.flatMap((s) => s.blocks).find((b) => b.type === 'text')?.html.match(/<h1[^>]*>(.*?)<\/h1>/)?.[1];
const headline = headingHtml
  ?.replace(/<br>/g, ' ')
  .replace(/<[^>]+>/g, '')
  .replace(/&amp;/g, '&')
  .replace(/&nbsp;/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();

// Share image: the first image beside the intro text (the hero holds only the logo).
const introSection = cs?.sections.find((s) => s.blocks.some((b) => b.type === 'text'));
const firstImage = introSection?.blocks.find((b) => b.type === 'image');
const shareImage = firstImage?.type === 'image' ? await getImage({ src: firstImage.src, width: 1200, format: 'jpg' }) : undefined;
---

<BaseLayout
  title={`${project.data.title} | Electric Collab`}
  description={cs ? (cs.seoDescription ?? headline) : undefined}
  image={shareImage ? { src: shareImage.src, width: Number(shareImage.attributes.width), height: Number(shareImage.attributes.height) } : undefined}
  headerTheme="light"
  noindex={!cs}
>
  {
    cs && (
      <>
        <JsonLd slot="head" data={caseStudyGraph({ name: project.data.title, path: `/portfolio/${project.id}`, headline: headline!, image: shareImage?.src })} />
        <CaseStudy project={project} />
        <ItemPagination prev={prev} next={next} />
      </>
    )
  }
</BaseLayout>
