---
/**
 * Site header: transparent bar over the first section (not sticky), with a
 * full-screen menu below 800px.
 *
 * The logo artwork is burgundy with a red bolt; on the dark header it is
 * rendered solid white via a CSS filter (as on the live site) and shown in its
 * true colors inside the open mobile menu.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo-wordmark.png';
import { headerCta, primaryNav, site } from '../../data/site';
import SocialLinks from '../ui/SocialLinks.astro';

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header" data-site-header>
  <div class="bar">
    <a class="logo" href="/" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" widths={[277, 554, 831]} sizes="277px" loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="cta" href={headerCta.href}>{headerCta.label}</a>
    </nav>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Open Menu</span>
      <span class="burger-box" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu data-lenis-prevent hidden>
    <nav aria-label="Primary">
      <ul class="mobile-nav">
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <SocialLinks class="mobile-social" />
    <a class="mobile-cta" href={headerCta.href}>{headerCta.label}</a>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--color-cream);
  }

  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--header-padding-y) var(--header-padding-x);
  }

  .logo {
    display: block;
    flex-shrink: 0;
  }

  .logo img {
    width: var(--logo-width);
    height: auto;
    /* Solid white on the dark header (matches Squarespace's .black-bold header filter). */
    filter: brightness(0) invert(1);
  }

  /* ---- Desktop navigation (≥800px) ---------------------------------------- */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: var(--page-gutter);
  }

  .nav-desktop ul {
    display: flex;
    gap: var(--page-gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-desktop a {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .nav-desktop .cta {
    display: block;
    line-height: 18px;
    text-transform: uppercase;
    border-bottom: 2px solid currentColor;
  }

  .nav-desktop .cta:hover {
    background-color: var(--color-cream);
    color: var(--color-red);
  }

  .burger {
    display: none;
  }

  /* ---- Collapsed header (≤799px) ------------------------------------------ */
  @media (max-width: 799px) {
    .nav-desktop {
      display: none;
    }

    .burger {
      display: block;
      flex-shrink: 0;
      padding: 1px 6px 1px 9px;
      background: none;
      border: 0;
      color: inherit;
    }

    .burger-box {
      position: relative;
      display: block;
      width: 35px;
      height: 35px;
    }

    .burger-box span {
      position: absolute;
      left: 0;
      top: 17px;
      width: 100%;
      height: 1px;
      background-color: currentColor;
    }

    .burger-box span:nth-child(1) {
      transform: translateY(-9.5px);
    }

    .burger-box span:nth-child(3) {
      transform: translateY(9.5px);
    }

    /* Open state: burger becomes a close (×) icon, logo shows true colors. */
    .site-header.is-open {
      color: var(--color-burgundy);
    }

    .site-header.is-open .logo img {
      filter: none;
    }

    .site-header.is-open .burger-box span:nth-child(1) {
      transform: rotate(45deg);
    }

    .site-header.is-open .burger-box span:nth-child(2) {
      opacity: 0;
    }

    .site-header.is-open .burger-box span:nth-child(3) {
      transform: rotate(-45deg);
    }
  }

  /* ---- Full-screen mobile menu -------------------------------------------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* Centered below the header bar, nudged to match the live menu's position. */
    padding-top: calc(var(--header-height) - 31px);
    background-color: var(--color-cream);
    color: var(--color-burgundy);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 23px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-nav a {
    display: block;
    font-family: var(--font-body);
    font-size: 25px;
    line-height: 45px;
    text-decoration: none;
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--color-red);
  }

  .mobile-menu :global(.mobile-social) {
    margin-top: 27px;
  }

  .mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 210px;
    height: 54px;
    margin-top: 92px;
    font-family: var(--font-eyebrow);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    color: #000;
    border-bottom: 2px solid currentColor;
  }

  @media (max-width: 767px) {
    .mobile-nav {
      gap: 11.5px;
    }

    .mobile-nav a {
      font-family: var(--font-eyebrow);
      font-size: 18px;
      line-height: 38px;
      letter-spacing: 0.5px;
    }

    .mobile-menu {
      padding-top: calc(var(--header-height) - 17px);
    }

    .mobile-menu :global(.mobile-social) {
      margin-top: 21px;
    }

    .mobile-cta {
      margin-top: 54px;
    }
  }

  @media (min-width: 800px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '../../scripts/scroll-lock';

  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');
  const menu = header?.querySelector<HTMLElement>('[data-mobile-menu]');

  if (header && toggle && label && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close Menu' : 'Open Menu';
      menu.hidden = !open;
      if (open) lockScroll();
      else unlockScroll();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close if the viewport grows past the collapsed-header breakpoint.
    window.matchMedia('(min-width: 800px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
