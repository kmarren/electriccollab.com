---
/**
 * Site footer. Two grid rows, laid out exactly like the live footer:
 * brand + navigation above the palette strip, then copyright and legal links.
 */
import { Image } from 'astro:assets';
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import Button from '../ui/Button.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import monogram from '../../assets/images/brand/ec-monogram.png';
import circleBadge from '../../assets/images/brand/badge-circle-gold-partner.png';
import entreprenistaBadge from '../../assets/images/brand/badge-entreprenista-100-2024.png';
import { footerNav, site } from '../../data/site';

const year = new Date().getFullYear();

/** Brand palette strip, left to right. */
const palette = ['periwinkle', 'burgundy', 'red', 'terracotta', 'blush', 'olive'];
---

<footer class="site-footer">
  <FluidSection as="div" rows={{ mobile: 28, desktop: 14 }} theme="dark">
    <FluidItem desktop="2/2/10/6" mobile="2/2/6/6" z={4}>
      <a class="monogram media-fill" href="/" aria-label={`${site.name} home`}>
        <Image src={monogram} alt="" widths={[212, 424]} sizes="(max-width: 767px) 117px, 212px" />
      </a>
    </FluidItem>

    <FluidItem desktop="6/22/8/25" mobile="2/6/6/10" z={{ mobile: 10, desktop: 11 }}>
      <SocialLinks size={25} gap={15} />
    </FluidItem>

    <FluidItem desktop="4/7/6/16" mobile="6/2/8/10" z={{ mobile: 6, desktop: 7 }} align="start">
      <p class="tagline">{site.tagline}</p>
    </FluidItem>

    <FluidItem desktop="6/7/8/13" mobile="8/2/10/8" z={{ mobile: 13, desktop: 14 }}>
      <Button href={footerNav.cta.href} fill weight={400} class="footer-cta">{footerNav.cta.label}</Button>
    </FluidItem>

    <FluidItem desktop="4/18/8/22" mobile="11/2/15/6" z={{ mobile: 0, desktop: 1 }} align="start" as="nav" aria-label="Footer">
      <ul class="footer-links">
        {
          footerNav.primary.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </FluidItem>

    <FluidItem desktop="4/22/7/26" mobile="11/6/15/10" z={{ mobile: 1, desktop: 2 }} align="start">
      <ul class="footer-links footer-links--secondary">
        {
          footerNav.secondary.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </FluidItem>

    <FluidItem desktop="12/1/15/27" mobile="18/1/21/11" z={{ mobile: 12, desktop: 13 }}>
      <div class="palette" aria-hidden="true">
        {palette.map((color) => <span style={`background-color: var(--color-${color})`} />)}
      </div>
    </FluidItem>

    <FluidItem desktop="10/2/12/9" mobile="22/2/24/10" z={{ mobile: 2, desktop: 3 }} align={{ desktop: 'center', mobile: 'start' }}>
      <p class="eyebrow location">{site.location.blurb}</p>
    </FluidItem>

    <FluidItem desktop="9/20/11/24" mobile="24/2/27/7" z={{ mobile: 4, desktop: 5 }}>
      <a class="badge media-fill" href="/" aria-label={`${site.name} home`}>
        <Image src={circleBadge} alt="Squarespace Circle Gold Partner 2025" widths={[173, 346]} sizes="(max-width: 767px) 166px, 173px" />
      </a>
    </FluidItem>

    <FluidItem desktop="9/24/11/26" mobile="24/7/27/10" z={{ mobile: 5, desktop: 6 }}>
      <a class="badge media-fill" href="https://www.entreprenista.com/100/2024" target="_blank" rel="noopener">
        <Image src={entreprenistaBadge} alt="Entreprenista 100 2024 award winner" widths={[68, 136, 204]} sizes="(max-width: 767px) 129px, 68px" />
      </a>
    </FluidItem>
  </FluidSection>

  <FluidSection as="div" rows={{ mobile: 3, desktop: 3 }} theme="dark">
    <FluidItem desktop="2/2/3/10" mobile="1/2/3/10" z={{ mobile: 8, desktop: 7 }} align={{ desktop: 'start', mobile: 'center' }}>
      <p class="legal">© {year} {site.legalName}.  |  All Right Reserved</p>
    </FluidItem>

    <FluidItem desktop="2/19/3/26" mobile="2/2/4/10" z={{ mobile: 7, desktop: 6 }} align={{ desktop: 'start', mobile: 'center' }}>
      <p class="legal legal--links">
        {
          footerNav.legal.map((link, i) => (
            <>
              {i > 0 && '  |  '}
              <a href={link.href}>{link.label}</a>
            </>
          ))
        }
      </p>
    </FluidItem>
  </FluidSection>
</footer>

<style>
  .monogram img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .tagline {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }

  .site-footer :global(.footer-cta:hover) {
    color: #cd060d;
    opacity: 0.8;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links li {
    font-family: var(--font-eyebrow);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    letter-spacing: 1px;
  }

  .footer-links a {
    line-height: 1.2rem;
    text-decoration: none;
  }

  /* The live footer sets "blog" in the body face. */
  .footer-links--secondary li + li {
    font-family: var(--font-body);
    line-height: var(--lh-body);
    letter-spacing: 0;
  }

  .palette {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    height: 100%;
  }

  .location {
    color: var(--color-red);
  }

  /* Badges are scaled to fit their grid block, centered. */
  .badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .legal {
    font-size: 1rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  .legal a {
    text-decoration: none;
    white-space: nowrap;
  }

  .legal--links {
    text-align: right;
  }
</style>
