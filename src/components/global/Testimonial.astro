---
/**
 * One testimonial section: a circular portrait beside (desktop) or above
 * (mobile) the quote and attribution. Grid placement comes from the live page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import { testimonials, type Testimonial as TestimonialData, type TestimonialKey } from '../../data/testimonials';

type Area = { desktop: string; mobile: string };

export interface Props {
  id: TestimonialKey;
  rows: { mobile: number; desktop: number };
  photo: Area;
  quote: Area;
}

const { id, rows, photo, quote } = Astro.props;
const t: TestimonialData = testimonials[id];

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/testimonials/*', { eager: true });
const image = photos[`../../assets/images/testimonials/${t.photo}`].default;

// On phones, Squarespace right-aligns the circle when its block is narrow
// (ends at column 5 of 8) and left-aligns it in full-width blocks.
const narrowOnMobile = photo.mobile.split('/')[3]?.trim() === '5';

// Split the attribution around the linked phrase, if any.
const [before, after] = t.link ? t.attribution.split(t.link.text) : [t.attribution, ''];
---

<FluidSection as="div" rows={rows} theme="light" class:list={{ 'testimonial--plain': t.tone === 'plain' }}>
  <FluidItem desktop={photo.desktop} mobile={photo.mobile} z={5} class:list={['testimonial-photo', { 'testimonial-photo--end': narrowOnMobile }]}>
    <Image
      class="photo"
      src={image}
      alt={t.photoAlt}
      widths={[129, 212, 424]}
      sizes="(max-width: 767px) 129px, 212px"
      style={t.photoPosition ? `object-position: ${t.photoPosition}` : undefined}
    />
  </FluidItem>

  <FluidItem desktop={quote.desktop} mobile={quote.mobile} z={4} as="figure" class="testimonial-quote">
    <blockquote>
      <p>{t.quote}</p>
      {t.continuation && <p class="continuation">{t.continuation}</p>}
    </blockquote>
    <figcaption class="eyebrow">
      {before}
      {t.link && (
        <a href={t.link.href} target="_blank" rel="noopener">
          {t.link.text}
        </a>
      )}
      {after}
    </figcaption>
  </FluidItem>
</FluidSection>

<style>
  /* Circle sized to the block's shorter side, vertically centered, left-aligned. */
  :global(.testimonial-photo) {
    container-type: size;
  }

  .photo {
    width: min(100cqw, 100cqh);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    :global(.testimonial-photo--end) .photo {
      align-self: flex-end;
    }
  }

  :global(.testimonial-quote) {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--color-terracotta);
  }

  blockquote .continuation {
    margin-top: 2rem;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  :global(.testimonial--plain) blockquote p,
  :global(.testimonial--plain) figcaption {
    color: var(--color-burgundy);
  }

  figcaption {
    margin-top: 2rem;
    color: var(--color-terracotta);
    text-transform: uppercase;
  }

  figcaption a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
