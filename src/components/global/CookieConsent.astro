---
/**
 * Lightweight cookie consent, replacing Squarespace's built-in banner (same
 * copy, layout and categories). Google Analytics is only loaded after the
 * visitor opts in to "Performance and Analytics". The choice is stored in
 * localStorage; the banner reappears if storage is unavailable.
 *
 * Advertising is listed to mirror the original banner; the site currently
 * loads no advertising scripts, so it gates nothing yet.
 */
export interface Props {
  /** GA4 measurement ID. */
  gaId: string;
}

const { gaId } = Astro.props;

const categories = [
  {
    id: 'necessary',
    title: 'Necessary',
    description:
      'Required to enable core site functionality and to remember user preferences and choices, such as language preferences or customized settings.',
    locked: true,
  },
  {
    id: 'analytics',
    title: 'Performance and Analytics',
    description:
      'These cookies provide quantitative measures of website visitors. With the usage of these cookies we are able to count visits and traffic sources to improve the performance of our site.',
  },
  {
    id: 'advertising',
    title: 'Advertising',
    description: 'These cookies are used by advertising companies to serve ads that are relevant to your interests.',
  },
];
---

<div class="cookie-banner" role="region" aria-label="Cookie consent" data-cookie-banner data-ga-id={gaId} hidden>
  <p>
    Select “Accept all” to agree to our use of cookies and similar technologies to enhance your browsing experience,
    security, analytics and customization. Select ”Manage cookies” to make more choices or opt out.
  </p>
  <div class="actions">
    <button type="button" class="btn-manage" data-cookie-manage>Manage cookies</button>
    <button type="button" class="btn-accept" data-cookie-accept>Accept all</button>
  </div>
</div>

<dialog class="cookie-dialog" aria-labelledby="cookie-dialog-title" data-cookie-dialog data-lenis-prevent>
  <form method="dialog" data-cookie-form>
    <div class="dialog-header">
      <h2 id="cookie-dialog-title">Manage Cookies</h2>
      <button type="button" class="btn-close" aria-label="Close" data-cookie-close>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" /></svg>
      </button>
    </div>

    {
      categories.map((category) => (
        <section class="category">
          <div class="category-header">
            <h3 id={`cookie-${category.id}`}>{category.title}</h3>
            {category.locked ? (
              <span class="status">Always on</span>
            ) : (
              <label class="toggle">
                <span class="status" data-cookie-status={category.id}>
                  Off
                </span>
                <input type="checkbox" role="switch" name={category.id} aria-labelledby={`cookie-${category.id}`} />
                <span class="track" aria-hidden="true" />
              </label>
            )}
          </div>
          <p>{category.description}</p>
        </section>
      ))
    }

    <div class="dialog-footer">
      <button type="submit" class="btn-accept">Save preferences</button>
    </div>
  </form>
</dialog>

<style>
  button {
    font-family: var(--font-body);
    font-size: 12px;
    text-transform: lowercase;
    color: inherit;
    cursor: pointer;
  }

  .btn-manage {
    padding: 11px 15px;
    background: none;
    border: 0;
    border-bottom: 2px solid var(--color-burgundy);
  }

  .btn-accept {
    padding: 11px 15px;
    background-color: var(--color-red);
    color: var(--color-cream);
    border: 0;
    border-radius: 10px;
  }

  /* ---- Banner -------------------------------------------------------------- */
  .cookie-banner {
    position: fixed;
    inset: auto 0 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 14px 20px;
    background-color: var(--color-cream);
    color: var(--color-burgundy);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    flex: 1;
    font-size: 12.544px;
    line-height: 1.5;
  }

  .actions {
    display: flex;
    gap: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 767px) {
    .cookie-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .cookie-banner p {
      font-size: 13.84px;
    }

    .actions {
      flex-direction: row-reverse;
    }
  }

  /* ---- Preferences dialog ------------------------------------------------- */
  .cookie-dialog {
    margin: auto;
    width: min(680px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    padding: 40px;
    border: 0;
    background-color: var(--color-cream);
    color: var(--color-burgundy);
  }

  .cookie-dialog::backdrop {
    background-color: rgb(0 0 0 / 0.64);
  }

  .dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .dialog-header h2 {
    font-size: 24px;
    line-height: 1.2;
    margin-top: 12px;
  }

  .btn-close {
    display: grid;
    place-items: center;
    width: 56px;
    height: 50px;
    margin: -26px -26px 0 0;
    background: none;
    border: 2px solid var(--color-burgundy);
  }

  .btn-close svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2.2;
  }

  .category {
    padding: 18px 0 20px;
    border-bottom: 2px solid rgb(64 8 13 / 0.25);
  }

  .category:last-of-type {
    border-bottom: 0;
  }

  .category-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .category h3 {
    font-family: var(--font-eyebrow);
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: 0.3px;
  }

  .category p {
    max-width: 500px;
    font-size: 12px;
    line-height: 1.4;
  }

  .status {
    font-size: 12px;
  }

  .toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .toggle input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .track {
    position: relative;
    width: 28px;
    height: 15px;
    border-radius: 999px;
    background-color: var(--color-terracotta);
  }

  .track::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--color-cream);
  }

  .toggle input:checked + .track {
    background-color: var(--color-red);
  }

  .toggle input:checked + .track::after {
    left: 15px;
  }

  .toggle input:focus-visible + .track {
    outline: 2px solid var(--color-burgundy);
    outline-offset: 2px;
  }

  .dialog-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
  }

  .dialog-footer .btn-accept {
    font-size: 12px;
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '../../scripts/scroll-lock';

  type Consent = { analytics: boolean; advertising: boolean };

  const STORAGE_KEY = 'ec-cookie-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cookie-dialog]');
  const form = document.querySelector<HTMLFormElement>('[data-cookie-form]');

  const read = (): Consent | null => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Consent) : null;
    } catch {
      return null;
    }
  };

  const loadAnalytics = (id: string) => {
    if (!id || document.querySelector('script[data-ga]')) return;
    const w = window as unknown as { dataLayer: unknown[]; gtag: (...args: unknown[]) => void };
    w.dataLayer = w.dataLayer || [];
    w.gtag = function gtag() {
      // gtag.js expects the `arguments` object itself.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('js', new Date());
    w.gtag('config', id);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    script.dataset.ga = '';
    document.head.append(script);
  };

  const apply = (consent: Consent) => {
    if (consent.analytics) loadAnalytics(banner?.dataset.gaId ?? '');
  };

  const save = (consent: Consent) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...consent, savedAt: new Date().toISOString() }));
    } catch {
      /* Storage unavailable (private mode); consent applies to this page view only. */
    }
    if (banner) banner.hidden = true;
    apply(consent);
  };

  const syncStatus = () => {
    form?.querySelectorAll<HTMLInputElement>('input[role="switch"]').forEach((input) => {
      const status = form.querySelector(`[data-cookie-status="${input.name}"]`);
      if (status) status.textContent = input.checked ? 'On' : 'Off';
    });
  };

  const openDialog = () => {
    const current = read();
    if (form && current) {
      (form.elements.namedItem('analytics') as HTMLInputElement).checked = current.analytics;
      (form.elements.namedItem('advertising') as HTMLInputElement).checked = current.advertising;
    }
    syncStatus();
    dialog?.showModal();
    lockScroll();
  };

  const existing = read();
  if (existing) apply(existing);
  else if (banner) banner.hidden = false;

  banner?.querySelector('[data-cookie-accept]')?.addEventListener('click', () => save({ analytics: true, advertising: true }));
  banner?.querySelector('[data-cookie-manage]')?.addEventListener('click', openDialog);
  dialog?.querySelector('[data-cookie-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', unlockScroll);
  form?.addEventListener('change', syncStatus);
  form?.addEventListener('submit', () => {
    save({
      analytics: (form.elements.namedItem('analytics') as HTMLInputElement).checked,
      advertising: (form.elements.namedItem('advertising') as HTMLInputElement).checked,
    });
  });
</script>
