---
/**
 * Previous / Next links at the foot of a collection item (case studies and
 * blog posts), labelled with each item's title.
 */
export interface PaginationLink {
  href: string;
  title: string;
}

export interface Props {
  prev?: PaginationLink;
  next?: PaginationLink;
  /** Light: cream bar with burgundy text (case studies). Dark: burgundy bar (blog). */
  theme?: 'light' | 'dark';
}

const { prev, next, theme = 'light' } = Astro.props;
---

<nav class:list={['item-pagination', `item-pagination--${theme}`]} aria-label={theme === 'dark' ? 'More posts' : 'More projects'}>
  {
    prev && (
      <a class="link link--prev" href={prev.href} rel="prev">
        <svg viewBox="0 0 9 16" aria-hidden="true">
          <polyline points="7.4,1.2 2.5,7.9 7.4,14.7" />
        </svg>
        <span class="visually-hidden">Previous:</span>
        <span class="title">{prev.title}</span>
      </a>
    )
  }
  {
    next && (
      <a class="link link--next" href={next.href} rel="next">
        <span class="visually-hidden">Next:</span>
        <span class="title">{next.title}</span>
        <svg viewBox="0 0 9 16" aria-hidden="true">
          <polyline points="1.6,1.2 6.5,7.9 1.6,14.7" />
        </svg>
      </a>
    )
  }
</nav>

<style>
  .item-pagination {
    display: flex;
    align-items: center;
    padding: 3vw 4vw;
    background-color: var(--color-cream);
    color: var(--color-burgundy);
  }

  .item-pagination--dark {
    background-color: var(--color-burgundy);
    color: var(--color-cream);
  }

  /* Each link takes at most half the row; long titles wrap. */
  .link {
    display: flex;
    align-items: center;
    gap: 25px;
    max-width: 50%;
    text-decoration: none;
  }

  .link--next {
    margin-left: auto;
    text-align: right;
  }

  .title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: 1;
  }

  svg {
    flex: 0 0 18px;
    width: 18px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    stroke-miterlimit: 10;
  }

  @media (max-width: 767px) {
    .item-pagination {
      padding: 3vw 6vw;
    }

    .title {
      font-size: 18px;
    }
  }
</style>
