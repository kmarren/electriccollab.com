---
/**
 * Per-page <head> metadata: title, description, canonical URL, Open Graph and
 * Twitter cards. Defaults mirror the live Squarespace homepage metadata.
 */
import { site } from '../../data/site';
import { allowIndexing } from '../../lib/indexing';

export interface Props {
  /** Full page title. Defaults to the site's homepage title. */
  title?: string;
  description?: string;
  /** Absolute or root-relative share image. */
  image?: { src: string; width: number; height: number };
  /** Exclude the page from search engines (e.g. placeholder pages). */
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title = site.defaultTitle,
  description = site.description,
  image = site.ogImage,
  noindex = false,
  ogType = 'website',
} = Astro.props;

// Canonical URLs never carry a trailing slash or `.html`, matching the live site.
// With `build.format: 'file'` the homepage path is reported as `/index.html`.
const path = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/(^|\/)index$/, '')
  .replace(/\/$/, '');
const canonical = new URL(path || '/', Astro.site).href.replace(/\/$/, '');
const imageUrl = new URL(image.src, Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || !allowIndexing) && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
