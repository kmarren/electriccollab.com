---
/**
 * A full-bleed page section laid out on the same grid Squarespace's Fluid
 * Engine uses, so block positions can be carried over from the live site 1:1.
 *
 *   mobile (≤767px):  8 content columns, rows ≥ 24px
 *   desktop (≥768px): 24 content columns, rows ≥ 2.15% of the content width
 *
 * Each side also gets a flexible gutter column, so a block spanning columns
 * 1→-1 is full-bleed while 2→-2 aligns with the page gutters. Gaps are 11px
 * unless the section overrides the column gap (as the live founder section does).
 * Rows grow with their content ("auto"), exactly like the original.
 *
 * Place children with <FluidItem>. Section background media (an image or
 * video filling the whole section) goes in the "background" slot.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'section'> {
  /** Row count on mobile and desktop (from the live section's grid). */
  rows: { mobile: number; desktop: number };
  theme?: 'dark' | 'light';
  /**
   * Column gap in px (default 11). Wide gaps are capped at 100vw/24 — the most
   * that still keeps every content column on screen — so the 24-column grid
   * can't push content off narrow viewports (a bug on the live site).
   */
  columnGap?: number;
  /** Row gap in px (default 11). */
  rowGap?: number;
  /** Squarespace "small" section height: 3.3vmax padding above and below the grid. */
  padded?: boolean;
  /**
   * Squarespace "medium" section height: at least 66vh tall, 6.6vmax padding
   * above and below the grid, content centered vertically.
   */
  medium?: boolean;
  /** First section on the page: also clears the transparent header. */
  clearHeader?: boolean;
  /**
   * Squarespace "inset" background: the section keeps the page background and
   * the content sits on a colored panel inset 4vw on every side (below the
   * header instead of 4vw from the top when `clearHeader` is set). Background
   * media then fills the panel rather than the section.
   */
  insetPanel?: 'red' | 'dark' | 'light';
  /** Render as a different landmark (e.g. 'div' inside the footer). */
  as?: 'section' | 'div';
}

const { rows, theme = 'dark', columnGap = 11, rowGap = 11, padded = false, medium = false, clearHeader = false, insetPanel, as: Tag = 'section', class: className, style, ...attrs } = Astro.props;
---

<Tag
  class:list={[
    'fluid-section',
    `theme-${theme}`,
    { 'fluid-section--inset': insetPanel, 'fluid-section--padded': padded, 'fluid-section--medium': medium, 'fluid-section--clear-header': clearHeader },
    className,
  ]}
  style={`--rows-mobile: ${rows.mobile}; --rows-desktop: ${rows.desktop}; --col-gap-base: ${columnGap}px; --row-gap: ${rowGap}px;${style ?? ''}`}
  {...attrs}
>
  {!insetPanel && Astro.slots.has('background') && (
    <div class="section-background">
      <slot name="background" />
    </div>
  )}
  {
    insetPanel ? (
      <div class:list={['inset-panel', `theme-${insetPanel}`]}>
        {Astro.slots.has('background') && (
          <div class="section-background">
            <slot name="background" />
          </div>
        )}
        <div class="fluid-grid">
          <slot />
        </div>
      </div>
    ) : (
      <div class="fluid-grid">
        <slot />
      </div>
    )
  }
</Tag>

<style>
  .fluid-section {
    position: relative;
  }

  .section-background {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .fluid-section--padded {
    padding-block: 3.3vmax;
  }

  .fluid-section--medium {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 66vh;
  }

  .fluid-section--medium:not(.fluid-section--inset),
  .fluid-section--medium .inset-panel {
    padding-block: 6.6vmax;
  }

  .fluid-section--medium .inset-panel {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    justify-content: center;
  }

  .fluid-section--clear-header {
    padding-top: var(--header-height);
  }

  .fluid-section--padded.fluid-section--clear-header {
    padding-top: calc(var(--header-height) + 3.3vmax);
  }

  .fluid-section--inset {
    padding: 4vw;
  }

  .fluid-section--inset.fluid-section--clear-header {
    padding-top: var(--header-height);
  }

  .inset-panel {
    position: relative;
  }

  .fluid-grid {
    position: relative;
    --gap: var(--col-gap-base);
    --grid-gutter: max(0px, calc(var(--page-gutter) - var(--gap)));
    --cell-max-width: calc((var(--page-max-width) - var(--gap) * 7) / 8);

    display: grid;
    grid-template-columns:
      minmax(var(--grid-gutter), 1fr)
      repeat(8, minmax(0, var(--cell-max-width)))
      minmax(var(--grid-gutter), 1fr);
    grid-template-rows: repeat(var(--rows-mobile), minmax(24px, auto));
    row-gap: var(--row-gap);
    column-gap: var(--gap);
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .fluid-grid {
      --gap: min(var(--col-gap-base), calc(100vw / 24));
      --cell-max-width: calc((var(--page-max-width) - var(--gap) * 23) / 24);
      --container-width: min(var(--page-max-width), calc(100vw - var(--page-gutter) * 2 - var(--inset-padding, 0px)));

      grid-template-columns:
        minmax(var(--grid-gutter), 1fr)
        repeat(24, minmax(0, var(--cell-max-width)))
        minmax(var(--grid-gutter), 1fr);
      grid-template-rows: repeat(var(--rows-desktop), minmax(calc(var(--container-width) * 0.0215), auto));
    }

    .fluid-section--inset .fluid-grid {
      --inset-padding: calc(var(--page-gutter) * 2);
    }
  }
</style>
