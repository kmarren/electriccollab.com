---
/**
 * Homepage hero: a staggered row of five portrait tiles (four looping videos
 * and one photo) and the H1 with its animated underline.
 * On phones the photo leads, followed by the headline and a 2×2 video grid.
 */
import { Image } from 'astro:assets';
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import AutoplayVideo from '../ui/AutoplayVideo.astro';
import DrawUnderline from '../ui/DrawUnderline.astro';
import portrait from '../../assets/images/hero/portrait-red-suit.jpg';

/** Video tiles share one frame shape; differently shaped clips letterbox inside it. */
const VIDEO_FRAME = '267.3 / 337.4';

const videos = [
  { src: '/videos/hero-jewelry', width: 540, height: 676, desktop: '2/2/12/7', mobile: '21/2/28/6', z: { desktop: 4, mobile: 3 } },
  { src: '/videos/hero-record', width: 540, height: 754, desktop: '2/7/12/12', mobile: '21/6/28/10', z: { desktop: 5, mobile: 4 } },
  { src: '/videos/hero-olive-coat', width: 540, height: 720, desktop: '2/16/12/21', mobile: '28/2/35/6', z: { desktop: 1, mobile: 6 } },
  { src: '/videos/hero-palette', width: 540, height: 716, desktop: '2/21/11/26', mobile: '28/6/35/10', z: { desktop: 5, mobile: 4 } },
];
---

<FluidSection rows={{ mobile: 34, desktop: 20 }} theme="dark" class="hero" aria-labelledby="hero-title">
  <FluidItem desktop="2/12/11/16" mobile="2/2/12/10" z={7}>
    <Image
      class="media-fill"
      src={portrait}
      alt="Woman in a red velvet blazer and striped trousers seated in a vintage armchair"
      widths={[212, 343, 424, 686, 1029]}
      sizes="(max-width: 767px) 88vw, 15vw"
      loading="eager"
      fetchpriority="high"
      style="object-position: 51.15% 14.4%"
    />
  </FluidItem>

  <FluidItem desktop="13/6/18/22" mobile="13/1/20/11" z={{ desktop: 2, mobile: 1 }}>
    <h1 id="hero-title" class="headline">
      Psychology-based brand strategy, design, and AI-amplified websites for founders who sell a <DrawUnderline>premium service</DrawUnderline>.
    </h1>
  </FluidItem>

  {
    videos.map((video, i) => (
      <FluidItem desktop={video.desktop} mobile={video.mobile} z={video.z} align="start">
        <AutoplayVideo src={video.src} width={video.width} height={video.height} frame={VIDEO_FRAME} eager={i < 4} />
      </FluidItem>
    ))
  }
</FluidSection>

<style>
  .hero {
    /* The transparent header overlays the top of the first section. */
    padding-top: var(--header-height);
  }

  .headline {
    padding-inline: 5%;
    text-align: center;
  }
</style>
