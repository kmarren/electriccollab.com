---
/**
 * Client testimonials: one light section per quote, with a circular portrait
 * that alternates sides on desktop and sits above the quote on mobile.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import { testimonials } from '../../data/testimonials';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/testimonials/*', { eager: true });

/** Live-site grid placement for each testimonial, in display order. */
const layouts = [
  { rows: { mobile: 18, desktop: 10 }, photo: { desktop: '4/5/10/9', mobile: '3/2/7/10' }, quote: { desktop: '4/10/11/23', mobile: '7/2/18/10' } },
  { rows: { mobile: 14, desktop: 10 }, photo: { desktop: '3/19/9/23', mobile: '1/2/5/5' }, quote: { desktop: '3/5/9/18', mobile: '5/2/13/10' } },
  { rows: { mobile: 14, desktop: 9 }, photo: { desktop: '1/5/8/9', mobile: '1/2/5/10' }, quote: { desktop: '2/10/7/23', mobile: '5/2/13/10' } },
  { rows: { mobile: 13, desktop: 9 }, photo: { desktop: '1/19/7/23', mobile: '1/2/5/10' }, quote: { desktop: '1/5/7/18', mobile: '5/2/12/10' } },
];
---

<div class="testimonials" aria-labelledby="testimonials-title">
  <h2 id="testimonials-title" class="visually-hidden">Client testimonials</h2>
  {
    testimonials.map((t, i) => {
      const layout = layouts[i];
      return (
        <FluidSection as="div" rows={layout.rows} theme="light">
          <FluidItem desktop={layout.photo.desktop} mobile={layout.photo.mobile} z={5} class="photo-block">
            <Image
              class="photo"
              src={photos[`../../assets/images/testimonials/${t.photo}`].default}
              alt={t.photoAlt}
              widths={[129, 212, 424]}
              sizes="(max-width: 767px) 129px, 212px"
              style={t.photoPosition ? `object-position: ${t.photoPosition}` : undefined}
            />
          </FluidItem>

          <FluidItem desktop={layout.quote.desktop} mobile={layout.quote.mobile} z={4} as="figure" class="quote">
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <figcaption class="eyebrow">
              {t.name} | {t.role}{' '}
              <a href={t.companyUrl} target="_blank" rel="noopener">
                {t.company}
              </a>
            </figcaption>
          </FluidItem>
        </FluidSection>
      );
    })
  }
</div>

<style>
  /* Circle sized to the block's shorter side, vertically centered, left-aligned. */
  .testimonials :global(.photo-block) {
    container-type: size;
  }

  .photo {
    width: min(100cqw, 100cqh);
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonials :global(.quote) {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    color: var(--color-terracotta);
  }

  figcaption {
    margin-top: 2rem;
    color: var(--color-terracotta);
    text-transform: uppercase;
  }

  figcaption a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
