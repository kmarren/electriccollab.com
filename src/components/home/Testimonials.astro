---
/**
 * Homepage testimonials: four quotes with portraits alternating sides.
 */
import Testimonial from '../global/Testimonial.astro';
---

<div aria-labelledby="testimonials-title">
  <h2 id="testimonials-title" class="visually-hidden">Client testimonials</h2>
  <Testimonial
    id="carrie-kerpen"
    rows={{ mobile: 18, desktop: 10 }}
    photo={{ desktop: '4/5/10/9', mobile: '3/2/7/10' }}
    quote={{ desktop: '4/10/11/23', mobile: '7/2/18/10' }}
  />
  <Testimonial
    id="lauren-bercuson"
    rows={{ mobile: 14, desktop: 10 }}
    photo={{ desktop: '3/19/9/23', mobile: '1/2/5/5' }}
    quote={{ desktop: '3/5/9/18', mobile: '5/2/13/10' }}
  />
  <Testimonial
    id="kelly-edmondson"
    rows={{ mobile: 14, desktop: 9 }}
    photo={{ desktop: '1/5/8/9', mobile: '1/2/5/10' }}
    quote={{ desktop: '2/10/7/23', mobile: '5/2/13/10' }}
  />
  <Testimonial
    id="lindsay-mahoney"
    rows={{ mobile: 13, desktop: 9 }}
    photo={{ desktop: '1/19/7/23', mobile: '1/2/5/10' }}
    quote={{ desktop: '1/5/7/18', mobile: '5/2/12/10' }}
  />
</div>
