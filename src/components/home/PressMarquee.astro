---
/**
 * "As featured in" logo strip that scrolls continuously and pauses on hover,
 * matching the live site's auto-scrolling carousel (one full set every ~61s).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Marquee from '../ui/Marquee.astro';
import { pressLogos } from '../../data/press';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/press/*.png', { eager: true });
const logos = pressLogos.map((logo) => ({ ...logo, image: files[`../../assets/images/press/${logo.file}`].default }));
---

<section class="press theme-dark" aria-labelledby="press-title">
  <h2 id="press-title" class="visually-hidden">As featured in</h2>
  <Marquee duration={61}>
    {
      logos.map((logo) => (
        <li class="press-logo">
          <Image src={logo.image} alt={logo.name} widths={[160, 320]} sizes="(max-width: 767px) 21vw, 8vw" />
        </li>
      ))
    }
  </Marquee>
</section>

<style>
  .press {
    --logo-width: 7.36vw;
    --spacing: 13.98vw;

    padding: 1vw 0 2vw;
  }

  /* Items are rendered inside <Marquee>, so they're styled globally from here. */
  .press :global(.press-logo) {
    flex: 0 0 var(--spacing);
    display: flex;
    justify-content: center;
  }

  .press :global(.press-logo img) {
    width: var(--logo-width);
    height: calc(var(--logo-width) * 9 / 16 + 1px);
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .press {
      --logo-width: 20.23vw;
      --spacing: 26.82vw;

      min-height: 100px;
      padding: 6vw 0;
    }
  }
</style>
