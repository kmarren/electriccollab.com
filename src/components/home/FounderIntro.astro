---
/**
 * "Led By Emily Paulsen" — founder introduction with an overlapping portrait.
 */
import { Image } from 'astro:assets';
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import Button from '../ui/Button.astro';
import portrait from '../../assets/images/founder/emily-paulsen.jpg';
---

<FluidSection rows={{ mobile: 41, desktop: 26 }} columnGap={37} theme="dark" aria-labelledby="founder-title">
  <FluidItem desktop="4/3/6/11" mobile="3/2/5/10" z={1} align="start">
    <p class="led-by">Led By</p>
  </FluidItem>

  <FluidItem desktop="5/3/8/11" mobile="4/2/7/10" z={{ desktop: 6, mobile: 7 }} align="start" class="name-block">
    <h2 id="founder-title" class="name">Emily Paulsen</h2>
  </FluidItem>

  <FluidItem desktop="8/3/13/11" mobile="7/2/11/10" z={{ desktop: 4, mobile: 6 }}>
    <p class="lede">Backed by a team with 45+ years of expertise developing brands that drive business through human connection.</p>
  </FluidItem>

  <FluidItem desktop="4/9/24/19" mobile="12/2/27/10" z={{ desktop: 2, mobile: 4 }}>
    <Image
      class="media-fill"
      src={portrait}
      alt="Emily Paulsen, founder of Electric Collab, smiling and seated beside a marble fireplace"
      widths={[316, 530, 632, 1060]}
      sizes="(max-width: 767px) 88vw, 37vw"
    />
  </FluidItem>

  <FluidItem desktop="11/18/18/26" mobile="28/2/38/10" z={{ desktop: 4, mobile: 2 }} align="start" class="rte">
    <p>
      Different from a traditional agency, designer or a doer, Electric Collab is your strategic partner. Through an
      immersive process based in meaningful collaboration, we translate your biggest ideas into a crystal-clear brand that <em>feels</em> like you.
    </p>
    <p>
      Partnering with 100+ founders, our work has led entrepreneurs to triple revenue, book entire quarters in advance,
      hire 6-figure teams, secure TED Talks, shift industries, win major media coverage, and build wealth while feeling
      fully expressed.
    </p>
  </FluidItem>

  <FluidItem desktop="18/18/20/24" mobile="38/2/41/10" z={{ desktop: 5, mobile: 3 }}>
    <Button href="/about" class="team-button">Meet your team</Button>
  </FluidItem>
</FluidSection>

<style>
  .led-by,
  .lede {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }

  /* Squarespace "scaled text": the name is sized to span its block's full width. */
  :global(.name-block) {
    container-type: inline-size;
  }

  /* Keep the label on one line where the capped column gap narrows this block. */
  :global(.team-button) {
    white-space: nowrap;
  }

  .name {
    font-size: 20.84cqi;
    line-height: 1;
    white-space: nowrap;
  }
</style>
