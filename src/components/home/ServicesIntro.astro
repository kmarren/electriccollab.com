---
/**
 * "Your brand is your reputation…" — the three offerings, separated by red
 * rules, beside a tall looping portrait video.
 */
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import AutoplayVideo from '../ui/AutoplayVideo.astro';

interface Offering {
  label: string;
  title: string;
  body: string;
  /** Grid areas: [label, title, body] on desktop and mobile; `rule` is the line above. */
  desktop: { rule: string; label: string; title: string; body: string };
  mobile: { rule: string; label: string; title: string; body: string };
  /** Stacking of the rule above this item (it passes behind the video). */
  ruleZ: { desktop: number; mobile: number };
}

const offerings: Offering[] = [
  {
    label: 'YOU NEED',
    title: 'Premium Positioning',
    body: 'that articulates the unique value only you deliver and matches it to the emotional needs of your ideal clients.',
    desktop: { rule: '8/3/9/25', label: '9/3/10/13', title: '10/3/12/13', body: '12/3/14/13' },
    mobile: { rule: '21/2/22/10', label: '22/2/23/10', title: '23/2/25/10', body: '25/2/28/10' },
    ruleZ: { desktop: 12, mobile: 11 },
  },
  {
    label: 'YOU DESERVE',
    title: 'Elevated Visual Identity',
    body: 'that captures attention, showcases your credibility, feels intentional, and lasts for the life of your business.',
    desktop: { rule: '14/3/15/25', label: '15/3/16/13', title: '16/3/18/13', body: '18/3/20/13' },
    mobile: { rule: '28/2/29/10', label: '29/2/30/10', title: '30/2/32/10', body: '32/2/35/10' },
    ruleZ: { desktop: 2, mobile: 10 },
  },
  {
    label: 'YOU HAVE AN OPPORTUNITY',
    title: 'Custom AI-Amplified Website',
    body: 'built in a format most entrepreneurs haven’t yet discovered. Our custom Astro sites are hand-crafted to prioritize conversion and self-expression, but built in the same language AI platforms automatically read and recommend.',
    desktop: { rule: '20/3/21/25', label: '21/3/22/13', title: '22/3/24/13', body: '24/3/27/13' },
    mobile: { rule: '35/2/36/10', label: '36/2/37/10', title: '37/2/39/10', body: '39/2/43/10' },
    ruleZ: { desktop: 3, mobile: 11 },
  },
];
---

<FluidSection rows={{ mobile: 45, desktop: 29 }} theme="light" aria-labelledby="services-title">
  <FluidItem desktop="8/17/29/25" mobile="1/2/20/10" z={{ desktop: 4, mobile: 6 }} align="start">
    <AutoplayVideo src="/videos/services-portrait" width={720} height={956} frame="434.3 / 728.1" />
  </FluidItem>

  <FluidItem desktop="4/8/7/20" mobile="18/2/21/10" z={{ desktop: 5, mobile: 8 }} align={{ desktop: 'start', mobile: 'center' }}>
    <h2 id="services-title" class="intro">Your brand is your reputation when you’re not in the room.</h2>
  </FluidItem>

  {
    offerings.map((item) => (
      <>
        <FluidItem desktop={item.desktop.rule} mobile={item.mobile.rule} z={item.ruleZ}>
          <hr class="rule" />
        </FluidItem>
        <FluidItem desktop={item.desktop.label} mobile={item.mobile.label} z={7}>
          <p class="eyebrow">{item.label}</p>
        </FluidItem>
        <FluidItem desktop={item.desktop.title} mobile={item.mobile.title} z={9}>
          <h3>{item.title}</h3>
        </FluidItem>
        <FluidItem desktop={item.desktop.body} mobile={item.mobile.body} z={6} align={{ desktop: 'start', mobile: 'center' }}>
          <p>{item.body}</p>
        </FluidItem>
      </>
    ))
  }

  <FluidItem desktop="26/3/28/25" mobile="43/2/44/10" z={{ desktop: 16, mobile: 12 }}>
    <hr class="rule" />
  </FluidItem>
</FluidSection>

<style>
  .intro {
    text-align: center;
  }

  /* 1px rule; the block keeps a ~18px minimum height, as Squarespace's divider block does. */
  .rule {
    width: 100%;
    height: 1px;
    margin-block: 8.45px;
    border: 0;
    background-color: var(--color-red);
  }
</style>
