---
/**
 * "You know a rebrand is the next step…" — intro copy, then the three
 * offerings, separated by red rules, beside a tall looping portrait video.
 */
import FluidSection from '../layout/FluidSection.astro';
import FluidItem from '../layout/FluidItem.astro';
import AutoplayVideo from '../ui/AutoplayVideo.astro';

interface Offering {
  label: string;
  title: string;
  /** May contain inline emphasis (rendered as HTML). */
  body: string;
  /** Grid areas: [label, title, body] on desktop and mobile; `rule` is the line above. */
  desktop: { rule: string; label: string; title: string; body: string };
  mobile: { rule: string; label: string; title: string; body: string };
  /** Stacking of the rule above this item (it passes behind the video). */
  ruleZ: { desktop: number; mobile: number };
}

const offerings: Offering[] = [
  {
    label: 'YOU NEED',
    title: 'Premium Positioning',
    body: 'that clarifies the unique value clients can <em>only get</em> from your business and matches it to their emotional needs. When everyone else is using AI to craft their message, this is the key to stand out and scale with premium buyers.',
    desktop: { rule: '13/3/14/25', label: '14/3/15/13', title: '15/3/17/13', body: '17/3/20/14' },
    mobile: { rule: '31/2/32/10', label: '32/2/33/10', title: '33/2/35/10', body: '35/2/39/10' },
    ruleZ: { desktop: 12, mobile: 11 },
  },
  {
    label: 'YOU DESERVE',
    title: 'Elevated Visual Identity',
    body: 'that captures attention, showcases your credibility, feels intentional, and lasts for the life of your business. We love creating original, trademarkable designs you can truly own forever.',
    desktop: { rule: '19/3/21/25', label: '21/3/22/13', title: '22/3/24/13', body: '24/3/27/14' },
    mobile: { rule: '39/2/40/10', label: '40/2/41/10', title: '41/2/43/10', body: '43/2/47/10' },
    ruleZ: { desktop: 2, mobile: 10 },
  },
  {
    label: 'YOU HAVE AN OPPORTUNITY',
    title: 'Custom Websites, Optimized for AI',
    body: 'built in a format most entrepreneurs haven’t yet discovered. Our custom Astro sites are hand-crafted to prioritize conversion and self-expression, but built in the same language AI platforms automatically read and recommend.',
    desktop: { rule: '26/3/28/25', label: '28/3/29/13', title: '29/3/31/13', body: '31/3/34/14' },
    mobile: { rule: '47/2/48/10', label: '48/2/49/10', title: '49/2/51/10', body: '51/2/55/10' },
    ruleZ: { desktop: 3, mobile: 11 },
  },
];
---

<FluidSection rows={{ mobile: 57, desktop: 36 }} theme="light" aria-labelledby="services-title">
  <FluidItem desktop="14/17/37/25" mobile="1/2/20/10" z={{ desktop: 4, mobile: 6 }} align="start">
    <AutoplayVideo src="/videos/services-portrait" width={720} height={956} frame="434.3 / 728.1" />
  </FluidItem>

  <FluidItem desktop="4/7/9/21" mobile="18/2/24/10" z={{ desktop: 5, mobile: 8 }} align={{ desktop: 'start', mobile: 'center' }}>
    <h2 id="services-title" class="intro">You know a rebrand is the next step in your growth strategy, but you don’t have the time (or desire) to reshape everything yourself.</h2>
  </FluidItem>

  <FluidItem desktop="9/7/12/21" mobile="24/2/30/10" z={{ desktop: 6, mobile: 9 }} align={{ desktop: 'start', mobile: 'center' }}>
    <p class="intro">
      Your business has already evolved and expanded (congratulations!) but now your brand feels disconnected from who you are today. You want a best-of-the-best partner who deeply understands your voice and vision, delivering a cohesive brand and website that works…while you focus on the work you do best.
    </p>
  </FluidItem>

  {
    offerings.map((item) => (
      <>
        <FluidItem desktop={item.desktop.rule} mobile={item.mobile.rule} z={item.ruleZ}>
          <hr class="rule rule--red" />
        </FluidItem>
        <FluidItem desktop={item.desktop.label} mobile={item.mobile.label} z={7}>
          <p class="eyebrow">{item.label}</p>
        </FluidItem>
        <FluidItem desktop={item.desktop.title} mobile={item.mobile.title} z={9}>
          <h3>{item.title}</h3>
        </FluidItem>
        <FluidItem desktop={item.desktop.body} mobile={item.mobile.body} z={6} align={{ desktop: 'start', mobile: 'center' }}>
          <p set:html={item.body} />
        </FluidItem>
      </>
    ))
  }

  <FluidItem desktop="33/3/35/25" mobile="55/2/56/10" z={{ desktop: 16, mobile: 12 }}>
    <hr class="rule rule--red" />
  </FluidItem>
</FluidSection>

<style>
  .intro {
    text-align: center;
  }
</style>
