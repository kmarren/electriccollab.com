---
/**
 * Previous / Next project links at the foot of a case study, in Squarespace
 * collection order (`order`), labelled with each project's full title.
 */
import type { CollectionEntry } from 'astro:content';

export interface Props {
  prev?: CollectionEntry<'portfolio'>;
  next?: CollectionEntry<'portfolio'>;
}

const { prev, next } = Astro.props;
const label = (p: CollectionEntry<'portfolio'>) => (p.data.subtitle ? `${p.data.title} | ${p.data.subtitle}` : p.data.title);
---

<nav class="item-pagination" aria-label="More projects">
  {
    prev && (
      <a class="link link--prev" href={`/portfolio/${prev.id}`} rel="prev">
        <svg viewBox="0 0 9 16" aria-hidden="true">
          <polyline points="7.4,1.2 2.5,7.9 7.4,14.7" />
        </svg>
        <span class="visually-hidden">Previous:</span>
        <span class="title">{label(prev)}</span>
      </a>
    )
  }
  {
    next && (
      <a class="link link--next" href={`/portfolio/${next.id}`} rel="next">
        <span class="visually-hidden">Next:</span>
        <span class="title">{label(next)}</span>
        <svg viewBox="0 0 9 16" aria-hidden="true">
          <polyline points="1.6,1.2 6.5,7.9 1.6,14.7" />
        </svg>
      </a>
    )
  }
</nav>

<style>
  .item-pagination {
    display: flex;
    align-items: center;
    padding: 3vw 4vw;
    background-color: var(--color-cream);
    color: var(--color-burgundy);
  }

  /* Each link takes at most half the row; long titles wrap. */
  .link {
    display: flex;
    align-items: center;
    gap: 25px;
    max-width: 50%;
    text-decoration: none;
  }

  .link--next {
    margin-left: auto;
    text-align: right;
  }

  .title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: 1;
  }

  svg {
    flex: 0 0 18px;
    width: 18px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
    stroke-miterlimit: 10;
  }

  @media (max-width: 767px) {
    .item-pagination {
      padding: 3vw 6vw;
    }

    .title {
      font-size: 18px;
    }
  }
</style>
