---
/**
 * Accordion built on native <details>/<summary>, matching Squarespace's
 * accordion block. Items sharing a group `name` behave exclusively (opening
 * one closes the others), as on the live site, with no JavaScript.
 *
 *   variant="receive"  — large serif title, 24px icon, solid red dividers
 *   variant="faq"      — uppercase label title, 14px icon, faint red dividers
 *   variant="plain"    — body-text title, 14px icon, solid red dividers
 *
 * `content` is trusted HTML authored in src/data.
 */
export interface AccordionItem {
  title: string;
  content: string;
}

export interface Props {
  items: AccordionItem[];
  name: string;
  variant?: 'receive' | 'faq' | 'plain';
  /** Draw a divider above the first item. */
  topDivider?: boolean;
  /** Heading level for item titles (keeps the document outline valid). */
  headingLevel?: 3 | 4;
}

const { items, name, variant = 'receive', topDivider = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<div class:list={['accordion', `accordion--${variant}`, { 'accordion--top-divider': topDivider }]}>
  {
    items.map((item) => (
      <details name={name}>
        <summary>
          <Heading class="title">{item.title}</Heading>
          <span class="icon" aria-hidden="true" />
        </summary>
        <div class="content" set:html={item.content} />
      </details>
    ))
  }
</div>

<style>
  .accordion {
    --divider-color: var(--color-red);
    --icon-size: 24px;
    --pad: 15px;
    width: 100%;
  }

  .accordion--faq {
    --divider-color: rgb(203 6 13 / 0.13);
    --icon-size: 14px;
    --pad: 30px;
  }

  .accordion--plain {
    --icon-size: 14px;
  }

  details {
    border-bottom: 1px solid var(--divider-color);
  }

  .accordion--top-divider details:first-child {
    border-top: 1px solid var(--divider-color);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--pad) 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Text keeps clear of the icon by the icon's width, as on the live site. */
  .title {
    flex: 1;
    padding-right: var(--icon-size);
    margin: 0;
    font-weight: 400;
    line-height: normal;
  }

  .accordion--receive .title {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
  }

  .accordion--plain .title {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    letter-spacing: normal;
    text-transform: none;
  }

  .accordion--faq .title {
    font-family: var(--font-eyebrow);
    font-size: var(--fs-h4);
    font-weight: 700;
    letter-spacing: 1px;
  }

  /* Plus icon; the vertical bar rotates flat to make a minus when open. */
  .icon {
    position: relative;
    flex: 0 0 var(--icon-size);
    height: var(--icon-size);
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: translateY(-50%);
  }

  .icon::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 200ms ease;
  }

  details[open] .icon::after {
    transform: translateY(-50%);
  }

  .content {
    padding-bottom: 30px;
  }

  .accordion--receive .content {
    width: max(300px, 70%);
  }

  .accordion--faq .content {
    width: 93%;
    margin-block: 16px;
    font-size: 1rem;
    line-height: 1.5;
  }

  .accordion--plain .content :global(ol) {
    margin: 0;
    padding-left: 40px;
  }

  .accordion--plain .content :global(li p) {
    margin-block: 0.5em;
  }

  .content :global(p + p) {
    margin-top: 1rem;
  }

  .content :global(a) {
    text-decoration: underline;
  }
</style>
