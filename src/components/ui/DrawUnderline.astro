---
/**
 * Inline text with an underline that draws in left-to-right once it scrolls
 * into view (2s, ease-out-quad), recreating Squarespace's animated text
 * highlight. Thickness scales with the font (0.05em) and the line runs 0.1em
 * past the glyphs, as on the live site. Works across line wraps.
 */
export interface Props {
  color?: 'red' | 'cream';
}

const { color = 'red' } = Astro.props;
---

<span class="draw-underline" style={`--underline-color: var(--color-${color})`} data-draw-underline><slot /></span>

<style>
  .draw-underline {
    background-image: linear-gradient(var(--underline-color), var(--underline-color));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 0% 0.05em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.1em;
    margin-inline: -0.1em;
    transition: background-size 2s cubic-bezier(0.5, 1, 0.89, 1);
  }

  .draw-underline:global(.is-drawn) {
    background-size: 100% 0.05em;
  }

  @media (prefers-reduced-motion: reduce) {
    .draw-underline {
      background-size: 100% 0.05em;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      entry.target.classList.add('is-drawn');
      observer.unobserve(entry.target);
    }
  });
  document.querySelectorAll('[data-draw-underline]').forEach((el) => observer.observe(el));
</script>
