---
/**
 * Link styled as one of the site's buttons.
 *
 *   solid     — cream pill with burgundy text ("meet your team", footer CTA)
 *   accent    — red pill with cream text ("take me to the request form")
 *   outline   — transparent with a 1px rounded border in the text color ("access the briefing")
 *   underline — transparent with a 2px bottom rule ("explore more work")
 *
 * `fill` stretches the button to its grid block, as Squarespace's
 * fluid-engine buttons do. `align` places an unfilled button horizontally in
 * its block. Labels are lowercased by CSS, as on the live site.
 *
 * Hover states match the live theme and switch instantly (no transition):
 * solid and accent fade to 80% opacity; outline and underline fill in.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'solid' | 'accent' | 'outline' | 'underline';
  fill?: boolean;
  align?: 'start' | 'center';
  weight?: 400 | 700;
  /** Label color for solid buttons (burgundy by default; red on red panels). */
  textColor?: 'burgundy' | 'red';
}

const { href, variant = 'solid', fill = false, align = 'start', weight = 700, textColor = 'burgundy', class: className, ...attrs } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, { 'button--fill': fill, 'button--center': align === 'center' }, className]} style={`--weight: ${weight}; --text-color: var(--color-${textColor})`} {...attrs}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 16px 1.3em;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: var(--weight);
    line-height: normal;
    letter-spacing: 0;
    text-transform: lowercase;
    text-decoration: none;
    text-align: center;
  }

  .button--center {
    align-self: center;
  }

  .button--fill {
    align-self: stretch;
    flex: 1;
    padding-block: 0;
  }

  .button--solid {
    background-color: var(--color-cream);
    color: var(--text-color);
    border-radius: 10px;
  }

  .button--accent {
    background-color: var(--color-red);
    color: var(--color-cream);
    border-radius: 10px;
  }

  .button--outline {
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 10px;
  }

  .button--underline {
    background: transparent;
    color: inherit;
    border-bottom: 2px solid currentColor;
  }

  .button--solid:hover,
  .button--accent:hover {
    opacity: 0.8;
  }

  /* Outline: fills with the section's text color; the border keeps its color. */
  .button--outline:hover {
    background-color: var(--color-cream);
    color: var(--color-red);
    border-color: var(--color-cream);
  }

  :global(.theme-light) .button--outline:hover {
    background-color: var(--color-burgundy);
    color: var(--color-periwinkle);
    border-color: var(--color-burgundy);
  }

  .button--underline:hover {
    background-color: var(--color-cream);
    color: var(--color-red);
  }
</style>
