---
/**
 * Link styled as one of the site's buttons.
 *
 *   solid     — cream pill with burgundy text ("meet your team", footer CTA)
 *   underline — transparent with a 2px bottom rule ("explore more work")
 *
 * `fill` stretches the button to its grid block, as Squarespace's
 * fluid-engine buttons do. Labels are lowercased by CSS, as on the live site.
 */
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'solid' | 'underline';
  fill?: boolean;
  weight?: 400 | 700;
  /** Label color for solid buttons (burgundy by default; red on red panels). */
  textColor?: 'burgundy' | 'red';
}

const { href, variant = 'solid', fill = false, weight = 700, textColor = 'burgundy', class: className, ...attrs } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, { 'button--fill': fill }, className]} style={`--weight: ${weight}; --text-color: var(--color-${textColor})`} {...attrs}>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 16px 1.3em;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: var(--weight);
    line-height: normal;
    letter-spacing: 0;
    text-transform: lowercase;
    text-decoration: none;
    text-align: center;
  }

  .button--fill {
    align-self: stretch;
    flex: 1;
    padding-block: 0;
  }

  .button--solid {
    background-color: var(--color-cream);
    color: var(--text-color);
    border-radius: 10px;
  }

  .button--underline {
    background: transparent;
    color: inherit;
    border-bottom: 2px solid currentColor;
  }
</style>
